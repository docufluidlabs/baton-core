{
  "name": "baton-front",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:preview": "vite build --config vite.config.preview.ts",
    "favicons": "node scripts/generate-favicons.mjs",
    "shots": "npm run build:preview && node scripts/capture-docs-screenshots.mjs",
    "gifs": "npm run build:preview && node scripts/capture-product-gifs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "repomix:full": "npx repomix . --output repomix-output-full.txt --ignore \"node_modules,.git,.next,dist,dist-preview,build,coverage\"",
    "repomix:ai": "npx repomix ./src --output repomix-output-ai.txt --ignore \"node_modules,.git,.next,dist,dist-preview,build,coverage\""
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "sonner": "^1.7.0",
    "swr": "^2.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.1",
    "gifenc": "^1.0.3",
    "jsdom": "^28.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.11"
  }
}
