# ══════════════════════════════════════════════════════════════
#  Baton configuration
#
#  Sections 1 and 2 are the whole setup for a normal install.
#  Everything from section 3 down already works as shipped, or is
#  optional — each block says exactly when you need it.
# ══════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════
#  1 · REQUIRED — set these two before the first start
# ══════════════════════════════════════════════════════════════
# Generate each one with:  openssl rand -hex 32
# (On Windows without openssl, any 32-byte hex string works.)

# Encrypts stored platform credentials at rest (AES-256-GCM).
# Changing it later makes existing connections unreadable — they must be reconnected.
TOKEN_ENCRYPTION_KEY=

# Signs login session cookies. Changing it later logs everyone out.
AUTH_JWT_SECRET=


# ══════════════════════════════════════════════════════════════
#  2 · DOCUSIGN — required to sync and launch workflows
# ══════════════════════════════════════════════════════════════
# Baton starts fine without these, but Workflow Builder is the destination
# for everything it does, so this is the second thing to set up.
#
# Where to get them: Docusign Admin → Settings → Apps and Keys → add an app.
# The Connections page in Baton shows a guided, field-by-field walkthrough
# including the exact redirect URI to register. Full guide: /docs/connect-docusign

DOCUSIGN_INTEGRATION_KEY=
# Shown only once when you create it — copy it immediately.
DOCUSIGN_SECRET_KEY=

# Which Docusign environment to talk to. Defaults below are the free
# developer sandbox; for production accounts use:
#   DOCUSIGN_OAUTH_BASE=https://account.docusign.com
#   DOCUSIGN_MAESTRO_API_BASE=https://api.docusign.com
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_MAESTRO_API_BASE=https://api-d.docusign.com


# ══════════════════════════════════════════════════════════════
#  3 · DEPLOYMENT — correct as shipped for `docker compose up`
# ══════════════════════════════════════════════════════════════
# Change these only when you put Baton on a real domain. Inbound webhook
# URLs and the Docusign redirect URI are generated from APP_URL / API_URL,
# so they must be the address the outside world can reach.
# For local development with real inbound webhooks, use a tunnel domain.

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# Max authenticated API requests per minute, per client IP.
RATE_LIMIT_PER_MINUTE=300


# ══════════════════════════════════════════════════════════════
#  4 · DATA STORES — correct as shipped for `docker compose up`
# ══════════════════════════════════════════════════════════════
# As shipped these point at the local emulators that come with
# docker compose (DynamoDB Local + ElasticMQ) — free, no accounts, and
# missing tables and queues are created automatically on first boot.
#
# For real AWS: leave both *_ENDPOINT values EMPTY, set the regions, and
# create the tables/queues first with the CloudFormation templates in
# baton/infrastructure/ (or `npm run db:create-tables`). On real AWS a
# missing table is a startup error — Baton never creates them for you there.
# Credentials can stay empty on EC2/ECS with an instance role.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

DYNAMODB_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local. Empty = real AWS.
DYNAMODB_TABLE_PREFIX=baton-

SQS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324        # ElasticMQ. Empty = real AWS.
SQS_QUEUE_PREFIX=baton-

# Single-org install: every user belongs to this organization.
BATON_ORG_ID=default-org


# ══════════════════════════════════════════════════════════════
#  5 · OPTIONAL — leave empty unless the case below applies
# ══════════════════════════════════════════════════════════════

# ─── Docusign status webhooks ─────────────────────────────────
# When you need it: to receive workflow status updates back from Docusign
# (Docusign Connect). Baton rejects unsigned Connect events, so without
# this key inbound status callbacks will not be accepted.
# Where: Docusign Admin → Connect → your configuration → HMAC key.
DOCUSIGN_CONNECT_HMAC_KEY=

# ─── Docusign account ID ──────────────────────────────────────
# When you need it: almost never. The account ID is captured automatically
# when you connect through OAuth. Set it only as a fallback for installs
# that talk to Workflow Builder before any connection exists.
DOCUSIGN_ACCOUNT_ID=

# ─── Docusign eSignature REST base ────────────────────────────
# When you need it: only if you run `scripts/setup-docusign-connect.ts`,
# the one-off helper that registers a Connect configuration for you.
# The API server never reads this. Default: https://demo.docusign.net/restapi
DOCUSIGN_BASE_URL=

# ─── Headless owner seed ──────────────────────────────────────
# When you need it: to create the organization and owner account without
# visiting the first-run setup screen — useful for scripted deployments.
# Set the email and password before the first start and the server seeds
# them on boot. Idempotent: skipped once any user exists.
BATON_OWNER_EMAIL=
BATON_OWNER_PASSWORD=
BATON_OWNER_NAME=
BATON_ORG_NAME=

# ─── Slack notifications ──────────────────────────────────────
# When you need it: to send notifications to Slack, or to answer @Baton
# mentions. Self-hosted installs register their own Slack app — a one-time
# ~10-minute step with a copy-paste manifest: docs/slack-notifications.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# ─── Email notifications (Resend) ─────────────────────────────
# When you need it: to email the loud events (failed workflow, exhausted
# automation, stopped bulk run, degraded connection). Without a key the
# email step is skipped silently; in-app and Slack are unaffected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Baton <notifications@example.com>
NOTIFICATION_FROM_EMAIL=notifications@example.com

# ─── API reference (Swagger UI) ───────────────────────────────
# When you need it: to expose the interactive API docs at /api/docs for your
# integration team. BOTH values must be set — they become the basic-auth
# login. Leaving either empty disables the docs routes entirely.
BATON_DOCS_USER=
BATON_DOCS_PASS=

# ─── Source platform credentials ──────────────────────────────
# When you need them: only for the three platforms below, and only if you
# connect them. Every other source (Salesforce, Zendesk, Airtable, Power
# Automate, monday.com, Greenhouse, and custom webhooks) needs nothing here —
# you set its secret per connection in the UI when you add the platform.

# BambooHR — OAuth app credentials.
BAMBOOHR_CLIENT_ID=
BAMBOOHR_CLIENT_SECRET=
BAMBOOHR_REDIRECT_URI=
BAMBOOHR_WEBHOOK_SECRET=

# Zoho CRM — OAuth app credentials.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
# Regional accounts server: .com (US), .eu, .in, .com.au, .com.cn, .jp
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com

# Smartsheet — OAuth app credentials. The webhook secret is an optional
# fallback for the shared /api/webhooks/smartsheet route; connections added
# through the UI use the Shared Secret you enter there.
SMARTSHEET_CLIENT_ID=
SMARTSHEET_CLIENT_SECRET=
SMARTSHEET_REDIRECT_URI=
SMARTSHEET_WEBHOOK_SECRET=

# HubSpot — optional global fallback only; the per-connection secret set
# in the UI is what normally verifies HubSpot webhooks.
HUBSPOT_WEBHOOK_SECRET=

# ─── Running more than one API container ──────────────────────
# When you need it: only when you scale out. Cron jobs must run on exactly
# one container — set SCHEDULER_ENABLED=false on every extra one.
# SCHEDULER_ENABLED=true

# ─── Log verbosity ────────────────────────────────────────────
# When you need it: to override the default level (debug in development,
# info in production). One of: trace, debug, info, warn, error, fatal.
# LOG_LEVEL=
