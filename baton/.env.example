# ══════════════════════════ CORE ═════════════════════════════
# Everything Baton needs to boot: app URLs, AWS-compatible infra
# (LocalStack or real AWS), encryption, and self-contained auth.

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Public URL of the app (webhook URLs are generated from this).
# For local dev with inbound webhooks, use a tunnel (e.g. your ngrok domain).
APP_URL=http://localhost:3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002
# Max authenticated API requests per minute, per client IP.
RATE_LIMIT_PER_MINUTE=300

# ─── AWS credentials (any values work for LocalStack) ─────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────────
# When DYNAMODB_ENDPOINT is set (LocalStack), missing tables are created automatically
# on boot. On real AWS (endpoint empty) tables must pre-exist — create them with the
# CloudFormation templates in baton/infrastructure/ or `npm run db:create-tables`.
DYNAMODB_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566   # LocalStack (docker-compose). Leave empty for real AWS.
DYNAMODB_TABLE_PREFIX=baton-

# ─── SQS ──────────────────────────────────────────────────────
SQS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566        # LocalStack (docker-compose). Leave empty for real AWS.
SQS_QUEUE_PREFIX=baton-

# ─── Encryption (tokens/secrets at rest, AES-256-GCM) ─────────
TOKEN_ENCRYPTION_KEY=       # 32-byte hex key for AES-256-GCM

# ─── Auth (self-contained email/password sessions) ────────────
AUTH_JWT_SECRET=            # generate with `openssl rand -hex 32`; required in production
BATON_ORG_ID=default-org    # single-org install: every user belongs to this org

# ─── Headless owner seed (optional) ───────────────────────────
# Creates the org + owner without visiting the setup screen. When email and
# password are set the server seeds them automatically on boot (or run
# `npm run seed` explicitly). Idempotent: skips when any user already exists.
BATON_OWNER_EMAIL=
BATON_OWNER_PASSWORD=
BATON_OWNER_NAME=
BATON_ORG_NAME=

# ═══════════════ OPTIONAL INTEGRATIONS ════════════════════════
# Connector and notification credentials — the backend starts
# without them; each one only gates its own integration.

# ─── DocuSign (destination — needed to sync/launch Workflow Builder workflows) ─
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_CONNECT_HMAC_KEY=
DOCUSIGN_MAESTRO_API_BASE=https://api-d.docusign.com   # Workflow Builder (Maestro) API

# ─── BambooHR (OAuth source connector) ────────────────────────
BAMBOOHR_CLIENT_ID=
BAMBOOHR_CLIENT_SECRET=
BAMBOOHR_REDIRECT_URI=
BAMBOOHR_WEBHOOK_SECRET=

# ─── HubSpot (webhook-only source) ────────────────────────────
# Optional global fallback; per-connection secrets are set in the UI.
HUBSPOT_WEBHOOK_SECRET=

# ─── Zoho CRM (OAuth source connector) ────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
# Regional accounts server: .com (US), .eu, .in, .com.au, .com.cn, .jp
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com

# ─── Notifications (Resend email) ─────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@iambaton.com
RESEND_FROM_EMAIL=Baton <notifications@iambaton.com>

# ─── Slack (distributed OAuth app for notifications) ──────────
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# ─── API Docs (Swagger UI + spec) ─────────────────────────────
# Both must be set to enable /api/docs and /api/docs.json (basic-auth).
# Leave empty to disable docs entirely.
BATON_DOCS_USER=
BATON_DOCS_PASS=
