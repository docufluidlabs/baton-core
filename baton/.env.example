# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Public URL of the app (webhook URLs are generated from this).
# For local dev with inbound webhooks, use a tunnel (e.g. your ngrok domain).
APP_URL=http://localhost:3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# ─── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────────
DYNAMODB_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566   # LocalStack (docker-compose). Leave empty for real AWS.
DYNAMODB_TABLE_PREFIX=baton-

# ─── SQS ──────────────────────────────────────────────────────
SQS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566        # LocalStack (docker-compose). Leave empty for real AWS.
SQS_QUEUE_PREFIX=baton-

# ─── Encryption ───────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=       # 32-byte hex key for AES-256-GCM

# ─── Clerk ────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ─── Stripe (Metered Billing) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Price IDs — created in Stripe Dashboard. Each plan has 2 prices:
#   <plan>_BASE     = flat licensed recurring (per plan)
#   <plan>_OVERAGE  = graduated tiered metered, tier1 free up to included, tier2 = overage rate
STRIPE_PRICE_STARTER_BASE=price_xxx
STRIPE_PRICE_STARTER_OVERAGE=price_xxx
STRIPE_PRICE_GROWTH_BASE=price_xxx
STRIPE_PRICE_GROWTH_OVERAGE=price_xxx
# Billing Meter — shared by both overage prices. Event name = relay.routed.
STRIPE_METER_ID=mtr_xxx
STRIPE_METER_RELAY_EVENT_NAME=relay.routed
# Growth overage rate in cents per relay .
STRIPE_GROWTH_OVERAGE_RATE_CENTS=12

# ─── DocuSign ─────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_CONNECT_HMAC_KEY=
DOCUSIGN_MAESTRO_API_BASE=https://api-d.docusign.com

# ─── Procore ──────────────────────────────────────────────────
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_REDIRECT_URI=
PROCORE_AUTH_URL=https://login.procore.com
PROCORE_WEBHOOK_SECRET=

# ─── Xero ─────────────────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=

# ─── BambooHR ─────────────────────────────────────────────────
BAMBOOHR_CLIENT_ID=
BAMBOOHR_CLIENT_SECRET=
BAMBOOHR_REDIRECT_URI=
BAMBOOHR_WEBHOOK_SECRET=

# ─── Zoho CRM ─────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# ─── Smartsheet ───────────────────────────────────────────────
SMARTSHEET_CLIENT_ID=
SMARTSHEET_CLIENT_SECRET=
SMARTSHEET_REDIRECT_URI=
SMARTSHEET_WEBHOOK_SECRET=

# ─── S3 ───────────────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Notifications ────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@iambaton.com
RESEND_FROM_EMAIL=Baton <notifications@iambaton.com>

# ─── Contact form (iambaton.com) ──────────────────────────────
CONTACT_FROM_EMAIL=noreply@iambaton.com
CONTACT_TO_EMAIL=hello@iambaton.com

# ─── Slack (distributed OAuth app) ───────────────────────────
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# ─── API Docs (Swagger UI + spec) ─────────────────────────────
# Both must be set to enable /api/docs and /api/docs.json (basic-auth).
# Leave empty to disable docs entirely.
BATON_DOCS_USER=
BATON_DOCS_PASS=
