graph TB
    subgraph users["👤 Users"]
        admin["Owner / Admin<br/><i>Manages connections,<br/>creates automations</i>"]
        member["Member / Viewer<br/><i>Views dashboards,<br/>monitors events</i>"]
    end

    baton["🔷 BATON<br/><b>Workflow Orchestration Platform</b><br/><i>Connects business platforms<br/>to Docusign Workflow Builder workflows<br/>via event-driven automation</i>"]

    docusign["📝 Docusign<br/><b>Workflow Builder + eSignature</b><br/><i>Workflow engine &amp; signing</i>"]

    subgraph external["Event Sources (inbound webhooks)"]
        sf["☁️ Salesforce<br/><b>CRM</b><br/><i>+ managed package</i>"]
        hubspot["🔶 HubSpot<br/><b>CRM &amp; Marketing</b>"]
        zoho["💼 Zoho CRM<br/><b>Sales CRM</b>"]
        zendesk["🎫 Zendesk<br/><b>Support</b>"]
        bamboo["👥 BambooHR<br/><b>HR Platform</b>"]
        smartsheet["📋 Smartsheet<br/><b>Work Mgmt</b>"]
        pautomate["🔁 Power Automate<br/><b>Microsoft Flows</b>"]
        airtable["🗃️ Airtable<br/><b>Databases</b>"]
        greenhouse["🌱 Greenhouse<br/><b>Recruiting</b>"]
        monday["📅 monday.com<br/><b>Work OS</b>"]
        custom["🔗 Custom Webhooks<br/><b>Any system</b><br/><i>authenticated POST</i>"]
    end

    notify["✉️ Notification Delivery<br/><b>Resend (email) + Slack (bot)</b>"]
    aws["☁️ AWS<br/><b>DynamoDB + SQS</b><br/><i>(local emulators for eval:<br/>DynamoDB Local + ElasticMQ)</i>"]

    admin -->|"Configure &amp; manage<br/>(email/password login)"| baton
