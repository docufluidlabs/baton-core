---
title: "Baton — UML Class Diagram: Domain Model"
---
classDiagram
    direction TB

    class Organization {
        +String id
        +String clerkOrgId
        +String name
        +String plan
        +Object settings
        +String createdAt
    }

    class User {
        +String id
        +String orgId
        +String clerkUserId
        +String email
        +String name
        +String role [admin|member|viewer]
        +String createdAt
    }

    class PlatformConnection {
        +String id
        +String orgId
        +String platform
        +String displayName
        +String status [healthy|warning|error|pending]
        +String encryptedAccessToken
        +String encryptedRefreshToken
        +Number tokenExpiresIn
        +Number tokenCreatedAt
        +String accountId
        +Object metadata
        +String lastError
        +String createdAt
    }

    class Workflow {
        +String id
        +String orgId
        +String maestroWorkflowId
        +String name
        +String description
        +String maestroStatus
        +String connectionId
        +Object triggerInputSchema
        +Number launchCount
        +String lastLaunchedAt
        +String createdAt
    }

    class WorkflowInstance {
        +String id
        +String orgId
        +String workflowId
        +String maestroInstanceId
        +String instanceName
        +String status [running|completed|failed|cancelled]
        +Object inputData
        +String startedAt
        +String completedAt
    }

    class AutomationRule {
        +String id
        +String orgId
        +String name
        +String connectionId
        +String sourcePlatform
        +String eventType
        +String eventLabel
        +Object conditions
        +String conditionsDisplay
        +String targetWorkflowId
        +Object actionConfig
        +String status [active|paused|error|disabled]
        +Number timesTriggered
        +Number failureCount
        +Number successRate
        +Number retryMaxAttempts
        +String retryStrategy
        +Number retryIntervalSec
        +String lastTriggeredAt
        +String createdAt
        +String createdBy
    }

    class PipelineEvent {
        +String id
        +String orgId
        +String eventType
        +String status [received|processing|matched|completed|failed]
        +String eventSummary
        +String sourcePlatform
        +String triggeredAt
        +String completedAt
        +Number durationMs
        +String errorMessage
        +String ruleId
        +String actionDescription
        +String userMessage
        +Boolean userActionable
    }

    class WebhookEvent {
        +String id
        +String platform
        +String eventType
        +Object headers
        +Object payload
        +String receivedAt
        +String processedAt
        +String status
    }

    class OAuthState {
        +String state
        +String orgId
        +String userId
        +String platform
        +String codeVerifier
        +Number ttl
        +String createdAt
    }

    class Notification {
        +String id
        +String recipientId
        +String orgId
        +String type
        +String title
        +String message
        +String severity [info|warning|error|success]
        +Boolean read
        +String actionUrl
        +String createdAt
    }

    class AuditLog {
        +String id
        +String orgId
        +String userId
        +String action
        +String resourceType
        +String resourceId
        +Object details
        +String createdAt
    }

    Organization "1" --> "*" User : has members
    Organization "1" --> "*" PlatformConnection : owns
    Organization "1" --> "*" Workflow : manages
    Organization "1" --> "*" AutomationRule : configures

    PlatformConnection "1" --> "*" AutomationRule : triggers via
    Workflow "1" --> "*" WorkflowInstance : launches
    Workflow "1" --> "*" AutomationRule : targeted by
    AutomationRule "1" --> "*" PipelineEvent : generates

    PlatformConnection ..> OAuthState : uses during auth
    PipelineEvent ..> WebhookEvent : originates from
    PipelineEvent ..> Notification : triggers
    User "1" --> "*" AuditLog : performs actions

    class PlatformConnector {
        &lt;&lt;interface&gt;&gt;
        +Platform platform
        +String displayName
        +authorize(orgId, userId) OAuthAuthorizeResult
        +handleCallback(params) OAuthTokens
        +refreshToken(token) OAuthTokens
        +isTokenExpired(createdAt, expiresIn) Boolean
        +verifyWebhookSignature(body, headers, secret) WebhookVerificationResult
        +extractEventInfo(payload) ExtractedEventInfo
        +testConnection(accessToken) ConnectionHealthCheck
        +getSupportedEventTypes() EventType[]
    }

    class ProcoreConnector {
        +platform = "procore"
    }
    class XeroConnector {
        +platform = "xero"
        -generatePKCE()
    }
    class BambooHRConnector {
        +platform = "bamboohr"
    }
    class ZohoCRMConnector {
        +platform = "zohocrm"
    }
    class SmartsheetConnector {
        +platform = "smartsheet"
    }
    class DocuSignConnector {
        +platform = "docusign"
        -jwtGrant()
    }

    PlatformConnector <|.. ProcoreConnector : implements
    PlatformConnector <|.. XeroConnector : implements
    PlatformConnector <|.. BambooHRConnector : implements
    PlatformConnector <|.. ZohoCRMConnector : implements
    PlatformConnector <|.. SmartsheetConnector : implements
    PlatformConnector <|.. DocuSignConnector : implements

    class EncryptionService {
        +encrypt(plaintext) EncryptedData
        +decrypt(encrypted) String
        +hmacSign(data) String
        +hmacVerify(data, signature) Boolean
    }

    class RuleEngineService {
        +createRule(data) AutomationRule
        +getRulesByOrg(orgId) AutomationRule[]
        +findMatchingRules(orgId, platform, eventType) AutomationRule[]
        +evaluateConditions(rule, eventData) Boolean
        +updateRuleStatus(id, status) void
        +deleteRule(id) void
    }

    class ConnectionService {
        +storeTokens(connId, tokens) void
        +getDecryptedTokens(connId) OAuthTokens
        +updateConnectionStatus(connId, status, error) void
        +refreshIfExpired(connection) OAuthTokens
    }

    ConnectionService --> EncryptionService : uses
    ConnectionService --> PlatformConnector : delegates to
    RuleEngineService --> PlatformConnector : matches events
