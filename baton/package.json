{
  "name": "baton",
  "version": "1.0.1",
  "private": true,
  "description": "Baton - Workflow orchestration platform backend (Docusign Workflow Builder + Business Platforms)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create-tables": "tsx scripts/create-dynamodb-tables.ts",
    "db:delete-tables": "tsx scripts/delete-dynamodb-tables.ts",
    "sqs:create-queues": "tsx scripts/create-sqs-queues.ts",
    "setup": "npm run db:create-tables && npm run sqs:create-queues",
    "seed": "tsx scripts/seed.ts",
    "infra:generate": "tsx scripts/generate-dynamodb-cfn.ts",
    "repomix:full": "npx repomix . --output repomix-output-full.txt --ignore \"node_modules,.git,.next,dist,build,coverage\"",
    "repomix:ai": "npx repomix ./src --output repomix-output-ai.txt --ignore \"node_modules,.git,.next,dist,build,coverage\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-dynamodb": "^3.1110.0",
    "@aws-sdk/client-sqs": "^3.1110.0",
    "@aws-sdk/lib-dynamodb": "^3.1110.0",
    "@slack/web-api": "^7.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docusign-esign": "^8.0.1",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "resend": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
